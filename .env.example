# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno requeridas en producción (Render.com).
# Copia este archivo como .env para desarrollo local con docker-compose.
# NUNCA subas el .env real al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos PostgreSQL
# En Render: copia el "Internal Database URL" y descompónlo en las variables
# individuales, o usa la URL completa si modificas DatabaseConfig.
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=crud_usuarios
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# JWT — genera un secret seguro con: openssl rand -base64 32
JWT_SECRET=replace-with-secure-base64-secret
JWT_EXPIRATION_SECONDS=900

# SMTP (opcional — si no se configura, los correos fallan silenciosamente)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_ADDRESS=your-email@example.com
SMTP_FROM_NAME=Gestion de Usuarios
